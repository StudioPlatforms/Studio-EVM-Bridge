[Unit]
Description=Bridge Relayer Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bridge-relayer
ExecStart=/usr/bin/node /root/bridge-relayer/dist/multichain-relayer-fixed-nonce.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bridge-relayer
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
