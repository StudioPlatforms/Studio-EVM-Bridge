# Bridge Relayer Configuration

# Private key for the relayer (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URLs
STUDIO_RPC_URL=https://mainnet2.studio-blockchain.com
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# STO Gas Provider Configuration
# Private key for the STO gas provider (without 0x prefix)
STO_GAS_PROVIDER_KEY=your_sto_gas_provider_key_here

# Email Notification Configuration
EMAIL_FROM=your-email@example.com
EMAIL_TO=recipient@example.com
